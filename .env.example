# ============================================================
# Gas Receipt Automation — Environment Variables
# ============================================================
# Copy to .env and fill in values.

# --- Server ---
PORT=8003
LUBELOGGER_URL=http://lubelogger:8080
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash-lite
SENTRY_DSN=

# --- OIDC (server-side JWT verification) ---
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_ALGORITHMS=RS256

# --- Client (served to browser via /config.js) ---
PUBLIC_OIDC_ISSUER=
PUBLIC_OIDC_CLIENT_ID=
PUBLIC_OIDC_AUDIENCE=
PUBLIC_OIDC_REDIRECT_URI=
PUBLIC_SENTRY_DSN=
